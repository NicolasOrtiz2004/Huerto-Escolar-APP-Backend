<?xml version="1.0" encoding="UTF-8"?>
<!--
    POM (Project Object Model) DE ESTE MICROSERVICIO
    Maven lee este archivo para saber: cómo se llama el proyecto, qué
    versión de Java usa, qué librerías descargar y cómo compilarlo/ejecutarlo.
    Al cambiar algo aquí, en IntelliJ aparece el botón "Load Maven Changes".
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- Versión del formato del pom (siempre 4.0.0) -->
    <modelVersion>4.0.0</modelVersion>

    <!-- El "padre" de Spring Boot fija versiones compatibles de todas las librerías -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <!-- Identidad del proyecto: grupo (como un "paquete"), nombre y versión -->
    <groupId>cl.duoc</groupId>
    <artifactId>ms-sensores</artifactId>
    <version>1.0.0</version>
    <name>ms-sensores</name>
    <description>Microservicio de lecturas simuladas de sensores del Huerto Escolar</description>

    <properties>
        <!-- Versión de Java con que se compila (funciona con JDK 17 o 21) -->
        <java.version>17</java.version>
    </properties>

    <!-- DEPENDENCIAS: librerías que Maven descarga de internet (Maven Central).
         Las de Spring no llevan <version> porque la fija el "padre" spring-boot-starter-parent. -->
    <dependencies>
        <!-- API REST: @RestController, @GetMapping, Tomcat embebido -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- JPA + Hibernate: @Entity y JpaRepository (acceso a MySQL sin escribir SQL a mano) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Validaciones: @NotBlank, @Size, @Pattern... en los DTO de entrada -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Driver de MySQL (solo se necesita al ejecutar) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Swagger UI: documentación interactiva en http://localhost:8083/swagger-ui.html -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.9</version>
        </dependency>

        <!-- Pruebas: JUnit 5 + Mockito + MockMvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- BUILD: cómo se compila y empaqueta el proyecto -->
    <build>
        <plugins>
            <!-- Permite "mvn spring-boot:run" y genera el .jar ejecutable -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
